<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NUnitVersion Condition="'$(NUnitVersion)' == ''">3.14.0</NUnitVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Rules/**/*.cs" />
    <Compile Include="../../Assets/_Project/Application/**/*.cs" />
    <Compile Include="../../Assets/_Project/Data/Dialogue/*.cs" />
    <Compile Include="../../Assets/_Project/Tests/EditMode/*.cs" />
    <None Include="../../Assets/_Project/Data/Dialogue/StarterDialogue.json" Link="StarterDialogue.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="$(NUnitVersion)" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
