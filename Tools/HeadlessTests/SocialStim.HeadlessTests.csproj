<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NUnitVersion Condition="'$(NUnitVersion)' == ''">3.14.0</NUnitVersion>
    <TargetFramework Condition="'$(NUnitVersion)' == '3.5.0'">net472</TargetFramework>
    <TargetFramework Condition="'$(NUnitVersion)' != '3.5.0'">net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Rules/**/*.cs" />
    <Compile Include="../../Assets/_Project/Application/**/*.cs" />
    <Compile Include="../../Assets/_Project/Presentation/Text/GamePresenter.cs" />
    <Compile Include="../../Assets/_Project/Data/Dialogue/*.cs" />
    <Compile Include="../../Assets/_Project/Tests/EditMode/*.cs" />
    <Compile Include="../../Assets/_Project/Tests/PlayMode/PresenterDisplayTests.cs" />
    <None Include="../../Assets/_Project/Data/Dialogue/*Dialogue.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../Assets/_Project/ScriptableObjects/Catalogs/StarterCatalog.asset" Link="StarterCatalog.asset" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="$(NUnitVersion)" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
  </ItemGroup>
</Project>
