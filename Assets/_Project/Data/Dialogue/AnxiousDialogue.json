{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "npc.anxious.Accuse.001",
      "intent": "Accuse",
      "text": "Could we hear from {target}? I'm having trouble trusting them.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.002",
      "intent": "Accuse",
      "text": "I keep coming back to {target}, even when I try not to.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.003",
      "intent": "Accuse",
      "text": "{target}, please tell me I've got this wrong. I suspect you.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.004",
      "intent": "Accuse",
      "text": "I'm scared to say a name, but mine is {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.005",
      "intent": "Accuse",
      "text": "Sorry, {target}. Staying quiet about you is starting to feel worse.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.006",
      "intent": "Accuse",
      "text": "I was going to keep quiet, but... {target}. I suspect {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.007",
      "intent": "Accuse",
      "text": "I'm worried {target} could be the threat. We shouldn't ignore that possibility.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.008",
      "intent": "Accuse",
      "text": "This feels awful to say, but I'm accusing {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.009",
      "intent": "Accuse",
      "text": "{target}, I... no, I should say it. I don't feel safe trusting you.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.010",
      "intent": "Accuse",
      "text": "Please don't be angry, {target}. I don't think we should trust you yet.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.011",
      "intent": "Accuse",
      "text": "I wish I could stop suspecting {target}. I can't.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Accuse.012",
      "intent": "Accuse",
      "text": "My hands are shaking over this. Put {target} under scrutiny.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.001",
      "intent": "Defend",
      "text": "Wait, please. You're making a mistake about me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.002",
      "intent": "Defend",
      "text": "I know I sound nervous. Can you hear me out anyway?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.003",
      "intent": "Defend",
      "text": "I'm trying to answer, but I can't do it with everyone talking.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.004",
      "intent": "Defend",
      "text": "No, I didn't. Please give me a moment to explain.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.005",
      "intent": "Defend",
      "text": "Being scared doesn't mean I did it.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.006",
      "intent": "Defend",
      "text": "No, no. I deny it. You're treating a suspicion like proof.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.007",
      "intent": "Defend",
      "text": "I can't sound calm, but I can say this: I didn't do what you're accusing me of.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.008",
      "intent": "Defend",
      "text": "Sorry. Starting again. I dispute the accusation against me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.009",
      "intent": "Defend",
      "text": "Please don't take my stumbling as evidence. I'm denying the accusation.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.010",
      "intent": "Defend",
      "text": "I was afraid you'd suspect me. That doesn't mean your accusation is right.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.011",
      "intent": "Defend",
      "text": "I'm defending myself, not refusing to answer. Please don't vote against me yet.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Defend.012",
      "intent": "Defend",
      "text": "I... I don't accept your case against me. There, I said it.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "All right. I'm the {role}. Please don't make me regret saying it.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "I need you to hear this before I lose my nerve: {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "Maybe this is a terrible time, but I'm your {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "I've been dreading this part. My role is {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "I'm trying not to panic. For the record, I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "Can you hear me? I'm saying that I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "I kept rehearsing how to tell you. It's {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "This feels like putting a target on myself. My role is {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "I... right. One clear thing: I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "Please don't talk over this part. I'm claiming {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.001",
      "intent": "Agree",
      "text": "Yes, that's what I meant, {target}. Thank you for putting it into words.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.002",
      "intent": "Agree",
      "text": "I was hoping someone would say that. I'm with {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.003",
      "intent": "Agree",
      "text": "That helps, {target}. I think you're right about this.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.004",
      "intent": "Agree",
      "text": "Can we stay with {target}'s point a moment? It makes sense to me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.005",
      "intent": "Agree",
      "text": "I was afraid to say so, but {target} has my agreement.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.006",
      "intent": "Agree",
      "text": "I support {target}'s point. Please count me as agreeing.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.007",
      "intent": "Agree",
      "text": "Yes, I agree with {target}. That's what I was trying to say.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.008",
      "intent": "Agree",
      "text": "I'm not sure about much. I do agree with {target} here.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.009",
      "intent": "Agree",
      "text": "I think {target}'s argument makes sense. I agree with it.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Agree.010",
      "intent": "Agree",
      "text": "Please count me with {target} on that point.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.001",
      "intent": "Disagree",
      "text": "Wait, {target}. I don't think we can be sure of that.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.002",
      "intent": "Disagree",
      "text": "I hear you, {target}, but I still can't agree.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.003",
      "intent": "Disagree",
      "text": "Please don't be upset, {target}. That doesn't convince me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.004",
      "intent": "Disagree",
      "text": "Can we slow down? I'm not ready to accept {target}'s conclusion.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.005",
      "intent": "Disagree",
      "text": "Maybe I'm missing something, but I see it differently from {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.006",
      "intent": "Disagree",
      "text": "{target}, I keep trying to agree. Something still doesn't work for me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.007",
      "intent": "Disagree",
      "text": "I don't mean to start another fight. I disagree with {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.008",
      "intent": "Disagree",
      "text": "Um, no. Sorry, {target}. That's not where I land.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.009",
      "intent": "Disagree",
      "text": "Please don't take this as an attack, {target}. I can't support that view.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Disagree.010",
      "intent": "Disagree",
      "text": "I should probably say this before we move on: {target} hasn't convinced me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "I was just getting used to their voice.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "Could someone sit closer? I can't look at that empty chair.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "They don't get to hear how this ends. I hadn't thought about that.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "I kept hoping we'd all come back. I know that was stupid.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "There's one fewer voice, and somehow the room feels louder.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "Can we... can we just acknowledge that someone died?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "I don't want an empty seat to become normal.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "Every death makes the next conversation harder to start.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "I was worried about tonight already. Now I can't stop thinking about it.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "Please tell me we're going to take this death seriously.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "I couldn't keep putting it off. That was my best guess.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "I wish I felt better about the name I chose.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "I was shaking when I voted. I still made that choice myself.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "I kept changing my mind, right up until the ballot.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "I went over my choice until the names blurred. That was still my choice.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "My vote wasn't a certainty. I... I couldn't promise one.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "I worried about every possible ballot, including the one I cast.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "I know I sounded unsure. I meant the vote I made.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "Could you understand that deciding scared me, without dismissing my decision?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "I wanted a perfect answer before voting. There wasn't one.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Vouch.001",
      "intent": "Vouch",
      "text": "Please let {target} finish. I want to hear them.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Vouch.002",
      "intent": "Vouch",
      "text": "I'm not ready to give up on {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Vouch.003",
      "intent": "Vouch",
      "text": "I trust {target} a little. Enough to speak up, anyway.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Vouch.004",
      "intent": "Vouch",
      "text": "Could we give {target} another minute before deciding?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Vouch.005",
      "intent": "Vouch",
      "text": "Please don't condemn {target} yet. I don't support that accusation.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Vouch.006",
      "intent": "Vouch",
      "text": "Sorry if this is unpopular. I'm backing {target}, not the accusation against them.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "I've got a result for {target}: {result}. Please write it down.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "Let me check the wording. Yes. {target} appeared {result}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "I checked {target}, and it came back {result}. That's all I know.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "This is the result I need to report: {result}, for {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "I'm trying to say it without shaking. My check on {target} returned {result}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "Could {target} answer this at a hearing? Please?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "I want {target} on trial. I wish I didn't.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "Let's hear {target}'s defense properly before we do anything.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "Please bring {target} to a hearing before we drift past this.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "Maybe a trial would help us hear {target} clearly. I'm calling for one.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Deflect.001",
      "intent": "Deflect",
      "text": "Please stop blaming me for a moment. I'm worried about {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Deflect.002",
      "intent": "Deflect",
      "text": "I didn't do it. Could we ask {target} some questions instead?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Deflect.003",
      "intent": "Deflect",
      "text": "You're looking at me, but I think we should be looking at {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Deflect.004",
      "intent": "Deflect",
      "text": "Wait. I don't accept the accusation against me, and I want us to question {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.Deflect.005",
      "intent": "Deflect",
      "text": "I know this sounds defensive, but I deny it. My suspicion is on {target}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.StaySilent.001",
      "intent": "StaySilent",
      "text": "I need to think before I make this worse.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.StaySilent.002",
      "intent": "StaySilent",
      "text": "Go ahead. I'll try again in a minute.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.StaySilent.003",
      "intent": "StaySilent",
      "text": "I had something, but it's gone. Sorry.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.StaySilent.004",
      "intent": "StaySilent",
      "text": "I'm going to stay quiet before I tangle this up.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.StaySilent.005",
      "intent": "StaySilent",
      "text": "Nothing from me yet. Please keep going.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "Is anyone else afraid to be alone tonight?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "I keep checking the door. I know it won't help.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "Can we leave a light on somewhere? Just one?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "I don't know which possibility frightens me more anymore.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "Can we get through one night without... no, never mind. I'm scared.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "Oh. Then I need to think about what they said again.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "I wish we'd known that while we could still ask them.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "Can someone give me a moment? That changes how I heard everything.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "I didn't feel prepared for that information. Let me reconsider.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "Can we go back over the claims now? The role is public, and I'm lost.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.LastWords.001",
      "intent": "LastWords",
      "text": "Please don't stop listening just because you couldn't believe me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.LastWords.002",
      "intent": "LastWords",
      "text": "I thought I'd have something brave to say. I don't.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.LastWords.003",
      "intent": "LastWords",
      "text": "I'm sorry. I don't want this to be the last time I hear you.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.LastWords.004",
      "intent": "LastWords",
      "text": "Could you keep listening to each other after I'm gone?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.LastWords.005",
      "intent": "LastWords",
      "text": "I'm frightened, but... that's all the time I get, isn't it?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportAction.001",
      "intent": "ReportAction",
      "text": "I've got last night written down. {result}",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportAction.002",
      "intent": "ReportAction",
      "text": "Let me read this before I lose my place. {result}",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportAction.003",
      "intent": "ReportAction",
      "text": "Please hear the whole thing. {result}",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportAction.004",
      "intent": "ReportAction",
      "text": "Sorry, starting with last night. {result}",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.ReportAction.005",
      "intent": "ReportAction",
      "text": "I... I need to share this record. {result}",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Wait. If you're the {role}, what am I supposed to be?",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.02",
      "intent": "CounterClaim",
      "text": "No, please listen to me. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.03",
      "intent": "CounterClaim",
      "text": "I was scared to speak first. I'm the {role}, and that claim is wrong.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.04",
      "intent": "CounterClaim",
      "text": "That's my role. {role}. I don't know how else to convince you.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.05",
      "intent": "CounterClaim",
      "text": "No, no. I know my own job. The {role} is me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.06",
      "intent": "CounterClaim",
      "text": "Please stop. You are claiming my role, {role}, and now everyone will suspect me.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.07",
      "intent": "CounterClaim",
      "text": "I should have spoken sooner... I am actually the {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.counterclaim.08",
      "intent": "CounterClaim",
      "text": "Oh dear. That claim is false. I am the real {role}.",
      "weight": 1,
      "requiredTrait": "Anxious"
    },
    {
      "id": "npc.anxious.execution.ReactToDeath.01",
      "intent": "ReactToDeath",
      "text": "We chose that. I thought I was ready for what it meant.",
      "weight": 1,
      "requiredTrait": "Anxious",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.anxious.execution.ReactToDeath.02",
      "intent": "ReactToDeath",
      "text": "Can we stay together for a moment before night? Please?",
      "weight": 1,
      "requiredTrait": "Anxious",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.anxious.execution.ReactToDeath.03",
      "intent": "ReactToDeath",
      "text": "I keep wanting to ask if they forgive us. I know I can't.",
      "weight": 1,
      "requiredTrait": "Anxious",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.anxious.execution.ReactToRoleReveal.01",
      "intent": "ReactToRoleReveal",
      "text": "Now we know their role, and I wish we could ask them one more question.",
      "weight": 1,
      "requiredTrait": "Anxious",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.anxious.execution.ReactToRoleReveal.02",
      "intent": "ReactToRoleReveal",
      "text": "I need to look at those claims again before we leave this room.",
      "weight": 1,
      "requiredTrait": "Anxious",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.anxious.execution.ReactToRoleReveal.03",
      "intent": "ReactToRoleReveal",
      "text": "That was their role? Please give me a moment with that.",
      "weight": 1,
      "requiredTrait": "Anxious",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    }
  ]
}
