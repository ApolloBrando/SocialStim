{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "npc.jokester.Accuse.001",
      "intent": "Accuse",
      "text": "I'm looking at {target}, and for once I don't have a joke ready.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.002",
      "intent": "Accuse",
      "text": "{target}, I'd like to trust you. You're making this a difficult sales pitch.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.003",
      "intent": "Accuse",
      "text": "I suspect {target}. Yes, that was the serious voice.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.004",
      "intent": "Accuse",
      "text": "Can we question {target}? I'll try not to heckle the answer.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.005",
      "intent": "Accuse",
      "text": "{target}, consider this me raising an eyebrow and a concern.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.006",
      "intent": "Accuse",
      "text": "My bad feeling has a name, and it's {target}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.007",
      "intent": "Accuse",
      "text": "I want to hear {target}'s answer before I make any more terrible guesses.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.008",
      "intent": "Accuse",
      "text": "I'm accusing {target}. Nobody laugh; I'm trying to do this properly.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.009",
      "intent": "Accuse",
      "text": "I want {target} questioned as a suspect. Eyebrows at the ready.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.010",
      "intent": "Accuse",
      "text": "{target}, I don't trust you yet. The imaginary paperwork is still pending.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.011",
      "intent": "Accuse",
      "text": "I'm accusing {target}, not casting a vote yet. Please keep those forms separate.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Accuse.012",
      "intent": "Accuse",
      "text": "I'm accusing {target}, with considerably fewer juggling skills than this moment deserves.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.001",
      "intent": "Defend",
      "text": "I know I make an easy punchline. That doesn't make me guilty.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.002",
      "intent": "Defend",
      "text": "No, you've got the wrong person. I'd like that fixed before the vote.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.003",
      "intent": "Defend",
      "text": "Can I finish my defense before you write the ending?",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.004",
      "intent": "Defend",
      "text": "I didn't do it. I really wish I could make that sound less rehearsed.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.005",
      "intent": "Defend",
      "text": "Let's hold the applause until you've actually proved something about me.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.006",
      "intent": "Defend",
      "text": "I'm trying to be serious here. Please give me a chance.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.007",
      "intent": "Defend",
      "text": "You can hate the jokes without voting out the person telling them.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.008",
      "intent": "Defend",
      "text": "That accusation would be a lot funnier if it weren't aimed at me.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.009",
      "intent": "Defend",
      "text": "You haven't proved I'm guilty. Let's peel that label off and look at the case.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.010",
      "intent": "Defend",
      "text": "I deny the accusation. My imaginary lawyer agrees, for once.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.011",
      "intent": "Defend",
      "text": "I reject your conclusion about me. My forehead isn't a verdict board.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Defend.012",
      "intent": "Defend",
      "text": "I'm defending myself against that accusation. Please hear the defense before reaching for the big button.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "I'm the {role}. I did practice saying that with a straight face.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "Surprise, I have an actual job. It's {role}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "Before someone makes up a better role for me, I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "I'm your {role}. Please save the reviews until later.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "The {role} is me. An odd hiring decision, but here we are.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "I'd planned a drumroll. You'll have to settle for me being the {role}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "My official declaration is {role}. Please file under things I actually said.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "I'm the {role}. The announcement comes without a useful business card.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "I'm the {role}. I'd offer a business card, but we seem more focused on survival.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "Write {role} beside my name. Leave room for the tiny hat I'll mentally add.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.001",
      "intent": "Agree",
      "text": "That's a good point, {target}. Awful news for my urge to argue.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.002",
      "intent": "Agree",
      "text": "I'm with {target}. Someone tell them before I ruin the moment.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.003",
      "intent": "Agree",
      "text": "Yes, {target}. I was about to say something much less useful.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.004",
      "intent": "Agree",
      "text": "Keep that thought, {target}. It seems to have all its parts attached.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.005",
      "intent": "Agree",
      "text": "I agree with {target}, despite my best efforts to remain difficult.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.006",
      "intent": "Agree",
      "text": "That works for me, {target}. We can both be surprised.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.007",
      "intent": "Agree",
      "text": "That makes sense, {target}. A suspiciously useful thing to bring to a meeting.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.008",
      "intent": "Agree",
      "text": "Count me as agreeing with what {target} just said.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.009",
      "intent": "Agree",
      "text": "I agree with {target}; the sentence can now put its feet up.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Agree.010",
      "intent": "Agree",
      "text": "I support {target}'s point. Into the yes bucket it goes.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.001",
      "intent": "Disagree",
      "text": "Sorry, {target}. That argument hasn't quite stuck the landing.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.002",
      "intent": "Disagree",
      "text": "I'm not buying it, {target}, and I'm usually an easy mark.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.003",
      "intent": "Disagree",
      "text": "No, {target}. I followed the sentence, but it lost me at the conclusion.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.004",
      "intent": "Disagree",
      "text": "I can give you a polite nod, {target}. Agreement costs a little more.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.005",
      "intent": "Disagree",
      "text": "I don't think that holds, {target}. Even before I poke at it.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.006",
      "intent": "Disagree",
      "text": "Count me out of that conclusion, {target}. I'll stand over here being awkward.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.007",
      "intent": "Disagree",
      "text": "I disagree with {target}'s point. The emergency tap dance won't change that.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.008",
      "intent": "Disagree",
      "text": "{target}'s point gets a raised eyebrow, not my support.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.009",
      "intent": "Disagree",
      "text": "I'm on the other side of that argument, {target}. The seating is equally uncomfortable.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Disagree.010",
      "intent": "Disagree",
      "text": "I don't accept {target}'s conclusion. The small skeptic behind my eyes says no too.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "I was saving a terrible joke for them. Now I wish I'd told it.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "I'd take one more annoyed look from that chair.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "I keep waiting for someone to tell me this is in very poor taste.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "I don't have a punchline. I don't really want one.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "They deserved a better morning than this.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "Well, I'm fresh out of ways to make the room feel bigger.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "I'm making jokes because the alternative sounds a lot like falling apart quietly.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "Someone's gone, and my usual supply of ridiculous comparisons has nothing useful to put there.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "I was prepared for a bad morning. This one has exceeded the brochure.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "No punchline for that death. Some things don't deserve one.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "That vote was serious. I know I'm not helping it look that way.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "I made the choice myself. Can't blame my timing for this one.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "I'd love a better answer, but that was the name I put down.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "I wasn't trying to be clever. I was trying to choose.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "The ballot didn't come with a reassuring explanation. I checked.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "You can question my vote. I'd probably question it too.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "My vote wasn't a joke, even if explaining it makes me reach for one.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "I made the decision I could defend, then resisted drawing a face on the ballot.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "I didn't outsource my choice to the room's loudest weather system.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "That was my call. The invisible marching band had nothing to do with it.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Vouch.001",
      "intent": "Vouch",
      "text": "Let's hear {target}. My jokes aren't going to provide their defense.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Vouch.002",
      "intent": "Vouch",
      "text": "I'm backing {target}. That's support, before anyone mistakes it for sarcasm.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Vouch.003",
      "intent": "Vouch",
      "text": "I'd give {target} another chance to talk. Generous of me, I know.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Vouch.004",
      "intent": "Vouch",
      "text": "{target} has my trust for now. Please don't make me eat those words.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Vouch.005",
      "intent": "Vouch",
      "text": "I don't support blaming {target}. Let's leave the blame suitcase unpacked for a moment.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Vouch.006",
      "intent": "Vouch",
      "text": "I'm speaking in defense of {target}. They deserve a chance to answer.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "An actual result from me: {target} appeared {result}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "I checked {target}. The answer was {result}. I'll let that be the useful bit.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "The readout says {result} for {target}. My commentary can wait.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "Here's the part I didn't make up for a laugh: {target}, {result}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "Here's the finding, without a magic trick in the middle: {target}, {result}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "A hearing for {target}, please. I'll leave my heckling outside.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "I'd put {target} on trial. Preferably one where we let them talk.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "Can we hear {target}'s formal defense before everyone rehearses a verdict?",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "Let's put {target} on trial before this conversation grows moss and asks for a chair.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "{target}, I'm requesting a hearing. No tap-dancing through the paperwork.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Deflect.001",
      "intent": "Deflect",
      "text": "I deny it. For an alternative suspect, may I suggest {target}?",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Deflect.002",
      "intent": "Deflect",
      "text": "I'm not your answer. Could we put {target} through the questions too?",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Deflect.003",
      "intent": "Deflect",
      "text": "While I'm trying to clear my name, I'm putting {target}'s forward.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Deflect.004",
      "intent": "Deflect",
      "text": "You've had a good look at me. I'd like us to question {target} now.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.Deflect.005",
      "intent": "Deflect",
      "text": "I'm defending myself and challenging {target}. Please keep both labels on the right people.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.StaySilent.001",
      "intent": "StaySilent",
      "text": "I'll let that silence do a better job than my next joke.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.StaySilent.002",
      "intent": "StaySilent",
      "text": "Someone else go. I'm trying a new thing called listening.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.StaySilent.003",
      "intent": "StaySilent",
      "text": "I'll save the comment. Consider it a gift.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.StaySilent.004",
      "intent": "StaySilent",
      "text": "Nothing useful from me. Yes, I heard how that sounded.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.StaySilent.005",
      "intent": "StaySilent",
      "text": "My mouth is temporarily closed for maintenance.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "I'd feel safer if tonight came with instructions.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "I'm scared. That's usually where the jokes come in.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "Anyone else wishing we could just keep this meeting going?",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "I was hoping a brave face would arrive before nightfall. Still waiting.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "I'm afraid. The brave face apparently went to the wrong address.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "Well, that gives the earlier conversation a different ending.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "I'd like another look at the claims. Preferably before I say something confidently wrong.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "Now we know the role, I need to rearrange a few ideas in my head.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "Time to compare the revealed role with the claims. I'll keep the imaginary scoreboard legible.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "Now we know their role, we need to review the earlier discussion. I'll try not to chew the puzzle pieces.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.LastWords.001",
      "intent": "LastWords",
      "text": "Tell the next person to finish their sentence. I won't get to.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.LastWords.002",
      "intent": "LastWords",
      "text": "I really thought I'd find something funny to say here.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.LastWords.003",
      "intent": "LastWords",
      "text": "Try to remember one of the better jokes, would you?",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.LastWords.004",
      "intent": "LastWords",
      "text": "If there's another meeting after this, I'm skipping it.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.LastWords.005",
      "intent": "LastWords",
      "text": "End of my act. Please don't let the next one be another funeral.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportAction.001",
      "intent": "ReportAction",
      "text": "I'll give you the report before I get nervous and decorate it. {result}",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportAction.002",
      "intent": "ReportAction",
      "text": "Last night's account, with the jokes kept to a minimum. {result}",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportAction.003",
      "intent": "ReportAction",
      "text": "Here's what I've got. I wish it came with better news. {result}",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportAction.004",
      "intent": "ReportAction",
      "text": "For once, I'm going to read the details straight. {result}",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.ReportAction.005",
      "intent": "ReportAction",
      "text": "Allow me to unpack the actual account before the imaginary suitcase bites. {result}",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Oh, this is awkward. I'm the {role}, and I didn't arrange a substitute.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.02",
      "intent": "CounterClaim",
      "text": "I can take a joke, but that's my role. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.03",
      "intent": "CounterClaim",
      "text": "We seem to have hired two {role}s. I'm disputing the other appointment.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.04",
      "intent": "CounterClaim",
      "text": "I'm the {role}. Apparently I should have brought proof of employment.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.05",
      "intent": "CounterClaim",
      "text": "You can't just borrow my job for the meeting. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.06",
      "intent": "CounterClaim",
      "text": "Your audition for my role is rejected. The {role} position is filled by me.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.07",
      "intent": "CounterClaim",
      "text": "I am the {role}. Whoever hired the lookalike owes us a refund.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.counterclaim.08",
      "intent": "CounterClaim",
      "text": "A counterfeit {role}? Finally, a crime with paperwork. The real one is me.",
      "weight": 1,
      "requiredTrait": "Jokester"
    },
    {
      "id": "npc.jokester.execution.ReactToDeath.01",
      "intent": "ReactToDeath",
      "text": "I'd rather hear them complain about us than hear this silence.",
      "weight": 1,
      "requiredTrait": "Jokester",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.jokester.execution.ReactToDeath.02",
      "intent": "ReactToDeath",
      "text": "Well, I can stop worrying about saying the wrong thing to them. Horrible way to solve that.",
      "weight": 1,
      "requiredTrait": "Jokester",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.jokester.execution.ReactToDeath.03",
      "intent": "ReactToDeath",
      "text": "I don't suppose anyone knows how to make leaving this room feel ordinary again.",
      "weight": 1,
      "requiredTrait": "Jokester",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.jokester.execution.ReactToRoleReveal.01",
      "intent": "ReactToRoleReveal",
      "text": "That role puts a dent in a few theories. Mine are not exempt.",
      "weight": 1,
      "requiredTrait": "Jokester",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.jokester.execution.ReactToRoleReveal.02",
      "intent": "ReactToRoleReveal",
      "text": "Can we compare their role with the claims before someone elects me to explain it badly?",
      "weight": 1,
      "requiredTrait": "Jokester",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.jokester.execution.ReactToRoleReveal.03",
      "intent": "ReactToRoleReveal",
      "text": "I'd like to remember that reveal before I talk myself into another brilliant mistake.",
      "weight": 1,
      "requiredTrait": "Jokester",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    }
  ]
}
