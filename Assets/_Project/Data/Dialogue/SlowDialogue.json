{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "npc.slow.Accuse.001",
      "intent": "Accuse",
      "text": "I've been thinking about {target}. Something still bothers me.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.002",
      "intent": "Accuse",
      "text": "Give me a moment with this. The person I suspect is {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.003",
      "intent": "Accuse",
      "text": "I don't have it all sorted out, but I don't trust {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.004",
      "intent": "Accuse",
      "text": "Before we leave that subject, could we question {target}?",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.005",
      "intent": "Accuse",
      "text": "{target}, I need to hear your answer again.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.006",
      "intent": "Accuse",
      "text": "I keep coming back to the same name. {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.007",
      "intent": "Accuse",
      "text": "Hang on. I wasn't finished thinking about {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.008",
      "intent": "Accuse",
      "text": "I've got a concern about {target}. Let me say it properly.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.009",
      "intent": "Accuse",
      "text": "The person I want us to question is {target}. I don't trust them yet.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.010",
      "intent": "Accuse",
      "text": "{target}, I need another look at what you're saying. It doesn't sit right.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.011",
      "intent": "Accuse",
      "text": "Wait, don't move on yet. I meant to accuse {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Accuse.012",
      "intent": "Accuse",
      "text": "Let me finish the thought... I think {target} may be the threat.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.001",
      "intent": "Defend",
      "text": "Can we take that question first? I can't answer everyone at once.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.002",
      "intent": "Defend",
      "text": "I heard you. I'm thinking about how to explain, not admitting anything.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.003",
      "intent": "Defend",
      "text": "Hold on. No, I didn't do it.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.004",
      "intent": "Defend",
      "text": "I need a little time. Please don't decide for me while I'm answering.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.005",
      "intent": "Defend",
      "text": "Let me go back to the beginning. You've got the wrong person.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.006",
      "intent": "Defend",
      "text": "I understand why you're asking. I don't agree with your answer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.007",
      "intent": "Defend",
      "text": "One thing at a time. I'm trying to give you a straight answer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.008",
      "intent": "Defend",
      "text": "I'm not finished, and I'm not agreeing that I'm guilty.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.009",
      "intent": "Defend",
      "text": "Hold on. I dispute the case against me. Please hear me through.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.010",
      "intent": "Defend",
      "text": "The part where you blame me... I don't accept that.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.011",
      "intent": "Defend",
      "text": "I'm still thinking through your questions. I haven't agreed with your accusation.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Defend.012",
      "intent": "Defend",
      "text": "Please wait. I'm denying the accusation, even if the words come slowly.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "Before I forget the important bit, I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "Right. My role. It's {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "I've thought about when to say this. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "You should probably know I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "Let me start with something I'm sure of. My role is {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "There's something I meant to tell everyone: I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "Oh. I can say my role now. It's {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "I've got the words ready this time: my role is {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "Before we change subjects... my role is {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "I'm the... {role}. Yes, that's my claim.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.001",
      "intent": "Agree",
      "text": "Oh, I see what you mean, {target}. Yes.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.002",
      "intent": "Agree",
      "text": "Give me a second. Yes, {target}, I think that follows.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.003",
      "intent": "Agree",
      "text": "I wanted to come back to {target}'s point. I'm with them.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.004",
      "intent": "Agree",
      "text": "I've let that settle, {target}. It makes sense.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.005",
      "intent": "Agree",
      "text": "I was thinking it through while you talked, {target}. I agree.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.006",
      "intent": "Agree",
      "text": "That's the bit I was looking for, {target}. I'll support it.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.007",
      "intent": "Agree",
      "text": "Let me add my yes to {target}'s point.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.008",
      "intent": "Agree",
      "text": "Oh... I understand your point now, {target}. I agree.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.009",
      "intent": "Agree",
      "text": "I had to think about it. I'm backing {target}'s view.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Agree.010",
      "intent": "Agree",
      "text": "Hold on... my answer to {target} is agreement.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.001",
      "intent": "Disagree",
      "text": "There's a step I'm missing there, {target}. I can't agree yet.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.002",
      "intent": "Disagree",
      "text": "I followed you until the conclusion, {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.003",
      "intent": "Disagree",
      "text": "Can we go over that again, {target}? I come out differently.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.004",
      "intent": "Disagree",
      "text": "I needed a moment to be sure. No, {target}, I don't think so.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.005",
      "intent": "Disagree",
      "text": "That doesn't quite fit for me, {target}. Let's stay with it.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.006",
      "intent": "Disagree",
      "text": "I know we've moved on, but I still disagree with {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.007",
      "intent": "Disagree",
      "text": "So... you're saying that, {target}. I'm saying no.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.008",
      "intent": "Disagree",
      "text": "Let me put the thought together... {target} hasn't convinced me.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.009",
      "intent": "Disagree",
      "text": "I heard you, {target}. I just don't reach the same answer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Disagree.010",
      "intent": "Disagree",
      "text": "Before I forget to say it... I oppose {target}'s point.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "I keep thinking of something I meant to ask them.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "It's the empty chair. I notice it, then I notice it again.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "I know they're gone. It just hasn't settled yet.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "We were talking a little while ago. I can't get past that.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "Give me a minute before the next subject, please.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "I don't want to get used to counting one less person.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "They were part of the room. Now they aren't. I'm getting there.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "Oh... that's why we have one less voice.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "I thought I understood what losing someone meant. This feels slower than a thought.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "We should... think about the person who died. Before the next thing.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "I thought it through as far as I could. Then I chose.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "I wasn't waiting for someone else's vote. I needed the time.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "That was the name I settled on. I'm still thinking about it.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "I couldn't work out every possibility before the ballot.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "I know my answer came late. It was still my answer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "Let me explain it from the beginning, if there's time.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "I had to decide before I felt completely caught up.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "The ballot part was clear. I meant the choice I made.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "Let me start with this... I did think before voting.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "I needed extra time, not someone else's decision.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Vouch.001",
      "intent": "Vouch",
      "text": "Wait. I haven't heard enough to give up on {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Vouch.002",
      "intent": "Vouch",
      "text": "{target} deserves time to finish. I'm still listening.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Vouch.003",
      "intent": "Vouch",
      "text": "I think we should keep {target} with us a little longer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Vouch.004",
      "intent": "Vouch",
      "text": "Don't rush {target}. Some answers take a moment.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Vouch.005",
      "intent": "Vouch",
      "text": "So... the person I'm defending is {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Vouch.006",
      "intent": "Vouch",
      "text": "Before we move on... I trust {target} for now.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "I've got it here. {target}: {result}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "The result was {result}. Sorry, that was for {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "Let me read it carefully. {target} appeared {result}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "I checked {target} last night. The answer came back {result}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "I'm reporting now... yes. My check on {target} came back {result}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "I'd like to hear {target}'s defense, at a proper trial.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "Can we question {target} one at a time in a hearing?",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "I think the next step is a trial for {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "Can we bring {target} to a hearing and go through this slowly?",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "Before we choose another subject, I want {target} questioned on trial.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Deflect.001",
      "intent": "Deflect",
      "text": "I'm still answering for myself, but I want to ask about {target} too.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Deflect.002",
      "intent": "Deflect",
      "text": "No, I didn't. The person I'm worried about is {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Deflect.003",
      "intent": "Deflect",
      "text": "Let me separate those thoughts. I deny it, and I suspect {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Deflect.004",
      "intent": "Deflect",
      "text": "I dispute the accusation against me. We should examine {target} instead.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.Deflect.005",
      "intent": "Deflect",
      "text": "Hold on. I don't think I'm your answer. I'm accusing {target}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.StaySilent.001",
      "intent": "StaySilent",
      "text": "I'm not there yet. Let someone else go.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.StaySilent.002",
      "intent": "StaySilent",
      "text": "I need to sit with that for a moment.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.StaySilent.003",
      "intent": "StaySilent",
      "text": "Keep talking. I'm still putting it together.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.StaySilent.004",
      "intent": "StaySilent",
      "text": "The thought isn't ready. I'll keep it to myself a little longer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.StaySilent.005",
      "intent": "StaySilent",
      "text": "I don't have my words yet... someone else can speak.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "I keep thinking about what happens when this room empties.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "Does anyone else wish we had a little more time?",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "The more I understand, the less I like tonight.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "Things are moving faster than I can feel safe about.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "I need a moment... being scared doesn't seem to wait for me.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "Wait. Then I need to hear their claim differently.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "Let me put that beside what they said earlier.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "I hadn't allowed for that role. Give me a moment.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "I'm catching up to the new fact. Don't let me forget it.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "That reveal means... something has to change in how I see this.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.LastWords.001",
      "intent": "LastWords",
      "text": "I was still working out what to say to you.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.LastWords.002",
      "intent": "LastWords",
      "text": "Take the time to hear the next person. Please.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.LastWords.003",
      "intent": "LastWords",
      "text": "I understand. I just wish understanding gave me longer.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.LastWords.004",
      "intent": "LastWords",
      "text": "Please don't rush the next person just because I took too long.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.LastWords.005",
      "intent": "LastWords",
      "text": "I think I'm finished... I wish I'd had the words sooner.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportAction.001",
      "intent": "ReportAction",
      "text": "Let me take you through it in order. {result}",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportAction.002",
      "intent": "ReportAction",
      "text": "I kept the details together this time. {result}",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportAction.003",
      "intent": "ReportAction",
      "text": "Right, last night. Here's where I started. {result}",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportAction.004",
      "intent": "ReportAction",
      "text": "Wait, this is the report I meant to give. {result}",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.ReportAction.005",
      "intent": "ReportAction",
      "text": "Starting with the night... not the vote. {result}",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Hold on. You said {role}, didn't you? That's my role.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.02",
      "intent": "CounterClaim",
      "text": "I've got to stop you there. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.03",
      "intent": "CounterClaim",
      "text": "I know this part for certain: I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.04",
      "intent": "CounterClaim",
      "text": "I was deciding when to tell you. I'm the {role}, so we need to talk.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.05",
      "intent": "CounterClaim",
      "text": "Oh. We have a problem then... I am the real {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.06",
      "intent": "CounterClaim",
      "text": "I heard the role claim. I need to challenge it... I am the {role}.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.07",
      "intent": "CounterClaim",
      "text": "Someone claimed my role first... but I am the {role}. I challenge that claim.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.counterclaim.08",
      "intent": "CounterClaim",
      "text": "One moment. I need to correct something. The {role} is me, not you.",
      "weight": 1,
      "requiredTrait": "Slow"
    },
    {
      "id": "npc.slow.execution.ReactToDeath.01",
      "intent": "ReactToDeath",
      "text": "So that's the end of their turn. I need a minute.",
      "weight": 1,
      "requiredTrait": "Slow",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.slow.execution.ReactToDeath.02",
      "intent": "ReactToDeath",
      "text": "I knew what the vote meant. Seeing it happen is different.",
      "weight": 1,
      "requiredTrait": "Slow",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.slow.execution.ReactToDeath.03",
      "intent": "ReactToDeath",
      "text": "Can we wait before moving on? There's something I haven't quite taken in.",
      "weight": 1,
      "requiredTrait": "Slow",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.slow.execution.ReactToRoleReveal.01",
      "intent": "ReactToRoleReveal",
      "text": "Let me think back to their claim with that role in mind.",
      "weight": 1,
      "requiredTrait": "Slow",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.slow.execution.ReactToRoleReveal.02",
      "intent": "ReactToRoleReveal",
      "text": "We get to know that now. They don't get to explain it.",
      "weight": 1,
      "requiredTrait": "Slow",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.slow.execution.ReactToRoleReveal.03",
      "intent": "ReactToRoleReveal",
      "text": "Hang on. That role changes how I understood the vote.",
      "weight": 1,
      "requiredTrait": "Slow",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    }
  ]
}
