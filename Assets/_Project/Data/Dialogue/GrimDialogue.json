{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "npc.grim.Accuse.001",
      "intent": "Accuse",
      "text": "I'd question {target}. I don't expect to enjoy the answer.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.002",
      "intent": "Accuse",
      "text": "There's no kind way to say this, {target}. I suspect you.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.003",
      "intent": "Accuse",
      "text": "I keep landing on {target}. Wish I didn't.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.004",
      "intent": "Accuse",
      "text": "{target}, you're the person I don't trust. Let's get it said.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.005",
      "intent": "Accuse",
      "text": "Keep questioning {target}. I don't trust them yet.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.006",
      "intent": "Accuse",
      "text": "{target} needs scrutiny. Nobody enjoys it. Do it anyway.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.007",
      "intent": "Accuse",
      "text": "I think {target} may be the threat. An ordinary miserable thought.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.008",
      "intent": "Accuse",
      "text": "Question {target}. Another uncomfortable conversation won't kill us by itself.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.009",
      "intent": "Accuse",
      "text": "{target}, I haven't found a reason to trust you.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.010",
      "intent": "Accuse",
      "text": "I'd start by questioning {target}. That's where my suspicion is.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.011",
      "intent": "Accuse",
      "text": "I don't think we should trust {target} yet. Comfort won't make them safe.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.012",
      "intent": "Accuse",
      "text": "I'm accusing {target}. There isn't a pleasant version of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.001",
      "intent": "Defend",
      "text": "No. You've got the wrong person. It happens.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.002",
      "intent": "Defend",
      "text": "Hear me out before you make this worse.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.003",
      "intent": "Defend",
      "text": "If you want a confession, you'll be disappointed.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.004",
      "intent": "Defend",
      "text": "I'm denying it. I haven't much else to give you.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.005",
      "intent": "Defend",
      "text": "I won't confess to something I deny just to shorten the discussion.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.006",
      "intent": "Defend",
      "text": "Don't condemn me yet. You still need to hear my defense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.007",
      "intent": "Defend",
      "text": "I deny the accusation. Raising your voice won't prove it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.008",
      "intent": "Defend",
      "text": "I won't accept that verdict against me. The case is unproven.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.009",
      "intent": "Defend",
      "text": "I dispute the charge. Give me a hearing, however unpleasant.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.010",
      "intent": "Defend",
      "text": "I deny the blame. That's my answer, stripped down.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.011",
      "intent": "Defend",
      "text": "I'm not agreeing with the accusation. I just expected to be suspected.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.012",
      "intent": "Defend",
      "text": "I reject the case against me. Whether anyone listens is another matter.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "Might as well know. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "I'm your {role}. Don't expect it to make this easy.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "Put {role} beside my name and be done with it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "There's no good moment for this. My role is {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "I'm claiming {role}. Another thing to worry about.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "The role I have to declare is {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "{role}. That's what I'm telling the room.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "You can question this too. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "No grand reveal. Just my claim: {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "Call me the {role}. Names won't make tonight shorter.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.001",
      "intent": "Agree",
      "text": "I'm with {target}. That's something, at least.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.002",
      "intent": "Agree",
      "text": "Yes, {target}. I came to the same miserable conclusion.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.003",
      "intent": "Agree",
      "text": "Leave that point where we can see it, {target}. I agree.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.004",
      "intent": "Agree",
      "text": "I think {target}'s right. I won't dress it up.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.005",
      "intent": "Agree",
      "text": "What {target} said will do. I agree.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.006",
      "intent": "Agree",
      "text": "What {target} said makes sense to me. I agree.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.007",
      "intent": "Agree",
      "text": "I'll back that conclusion, {target}. Don't expect applause.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.008",
      "intent": "Agree",
      "text": "I reach the same conclusion as {target}. An unpleasant agreement.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.009",
      "intent": "Agree",
      "text": "I support {target}'s point. Useful ones have been scarce.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.010",
      "intent": "Agree",
      "text": "I agree with {target}. That's the whole contribution.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.001",
      "intent": "Disagree",
      "text": "No, {target}. I can't get there with you.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.002",
      "intent": "Disagree",
      "text": "I'd like that to convince me, {target}. It doesn't.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.003",
      "intent": "Disagree",
      "text": "Don't mistake my silence for agreement, {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.004",
      "intent": "Disagree",
      "text": "I heard the argument, {target}. I'm still on the other side.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.005",
      "intent": "Disagree",
      "text": "Don't count me as agreeing with {target}'s point.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.006",
      "intent": "Disagree",
      "text": "I oppose that point, {target}. Quietly, if possible.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.007",
      "intent": "Disagree",
      "text": "I reject {target}'s argument. Calling it reassuring won't strengthen it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.008",
      "intent": "Disagree",
      "text": "I disagree with {target}'s point. Best say it now.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.009",
      "intent": "Disagree",
      "text": "I won't back {target}'s argument just to finish talking.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.010",
      "intent": "Disagree",
      "text": "That view from {target} doesn't survive a second look for me.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "I keep looking at the chair as if that helps.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "One more person we'll only talk about in the past tense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "They were here. Now we have to get through this without them.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "Nothing good to say about an empty place.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "Someone is gone. The meeting continues. That's the cruelty of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "An empty place. We can stop expecting an answer from it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "There should have been another ordinary morning for them.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "We all heard the report. Hearing it didn't make it easier.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "The dead have run out of mistakes. We haven't.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "A life ended. Nothing useful to add to that arithmetic.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "I picked a name. The doubt stayed with me.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "That was my vote. There's no comfort in blaming the room.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "I did what I could with what I knew. I wish that were enough.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "The ballot didn't wait until I felt ready.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "I didn't find certainty. The vote couldn't wait for it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "There was no painless choice. I made one anyway.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "I meant my ballot. Regret doesn't rewrite it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "My decision came from my own assessment. No escape in that.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "I voted with the information I had, not the information I wanted.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "The choice is on record. I'll answer for it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.001",
      "intent": "Vouch",
      "text": "I'd keep listening to {target}. We can still do that much.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.002",
      "intent": "Vouch",
      "text": "{target} has my backing. For now is all anyone gets.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.003",
      "intent": "Vouch",
      "text": "I don't want {target} condemned before they've finished.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.004",
      "intent": "Vouch",
      "text": "Give {target} time. We're running short of chances to hear people.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.005",
      "intent": "Vouch",
      "text": "I trust {target} enough to speak in their defense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.006",
      "intent": "Vouch",
      "text": "I'm supporting {target}. Hear them before deciding who to lose.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "The check on {target} came back {result}. There you have it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "{result}, for {target}. That's what I received.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "I have a finding to put down: {target} appeared {result}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "My investigation returned {result} on {target}. No ceremony needed.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "Here's the finding: {target}, {result}. Make of it what you can.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "A trial for {target}. We won't like it better by waiting.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "I'd hear {target}'s formal defense before this gets any uglier.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "Let's question {target} at a hearing and get through it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "{target} should give a formal defense. That's my request.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "Open the hearing for {target}. Delaying the question won't soften it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.001",
      "intent": "Deflect",
      "text": "I didn't do it. I'm still waiting for an answer from {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.002",
      "intent": "Deflect",
      "text": "You're not getting a confession from me. Question {target} too.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.003",
      "intent": "Deflect",
      "text": "The blame doesn't fit me. I'd start looking at {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.004",
      "intent": "Deflect",
      "text": "I dispute the case against me. Start looking at {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.005",
      "intent": "Deflect",
      "text": "I deny your accusation. Now hear mine: I suspect {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.001",
      "intent": "StaySilent",
      "text": "Let the next person try.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.002",
      "intent": "StaySilent",
      "text": "I've nothing worth making you hear.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.003",
      "intent": "StaySilent",
      "text": "I'm staying quiet. Don't make too much of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.004",
      "intent": "StaySilent",
      "text": "No addition. We can let a thought end.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.005",
      "intent": "StaySilent",
      "text": "I'll keep this turn empty.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "I don't much like the thought of another night alone.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "I'm afraid too. Just tired of finding new words for it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "We'll have to leave this room eventually. That's the part I keep thinking about.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "I can face the dark without trusting it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "We have a future to fear. That's better than no future, I suppose.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "There it is. Now put it beside everything they told us.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "We get the answer after we lose the chance to ask why.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "That role makes the earlier conversation harder to forget.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "Put the revealed role beside the old claims. See what remains standing.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "That changes the record. The past stays just as unpleasant.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.001",
      "intent": "LastWords",
      "text": "Remember the people. You can argue about the rest.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.002",
      "intent": "LastWords",
      "text": "I'd have liked another ordinary morning.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.003",
      "intent": "LastWords",
      "text": "Take care with the next name you choose.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.004",
      "intent": "LastWords",
      "text": "Make the next choice carefully. You can't return this one.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.005",
      "intent": "LastWords",
      "text": "No grand ending. Just the end I got.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.001",
      "intent": "ReportAction",
      "text": "Here's what I have left from the night. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.002",
      "intent": "ReportAction",
      "text": "The account won't make better reading by waiting. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.003",
      "intent": "ReportAction",
      "text": "I'll give you the details and sit down. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.004",
      "intent": "ReportAction",
      "text": "Another record for the living. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.005",
      "intent": "ReportAction",
      "text": "Details, since we still need them. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Of course someone picked my role. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.02",
      "intent": "CounterClaim",
      "text": "I'm the {role}. Now neither of us gets a quiet day.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.03",
      "intent": "CounterClaim",
      "text": "That claim's wrong. I'm the {role}, for all the good saying it will do.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.04",
      "intent": "CounterClaim",
      "text": "I wasn't planning to announce it like this. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.05",
      "intent": "CounterClaim",
      "text": "There goes my cover. The real {role} is me.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.06",
      "intent": "CounterClaim",
      "text": "I am the {role}. Apparently even my work has an impostor.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.07",
      "intent": "CounterClaim",
      "text": "I challenge that claim. I'm the {role}. Another problem to deal with.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.08",
      "intent": "CounterClaim",
      "text": "No. You took the wrong title. I am the {role}. This will end badly.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.execution.ReactToDeath.01",
      "intent": "ReactToDeath",
      "text": "No taking that vote back now.",
      "weight": 1,
      "requiredTrait": "Grim",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.grim.execution.ReactToDeath.02",
      "intent": "ReactToDeath",
      "text": "They're gone. We still have to leave this room and face the night.",
      "weight": 1,
      "requiredTrait": "Grim",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.grim.execution.ReactToDeath.03",
      "intent": "ReactToDeath",
      "text": "Another name we won't hear answering at the next meeting.",
      "weight": 1,
      "requiredTrait": "Grim",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.grim.execution.ReactToRoleReveal.01",
      "intent": "ReactToRoleReveal",
      "text": "Write the role down. We won't get a clearer answer from them.",
      "weight": 1,
      "requiredTrait": "Grim",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.grim.execution.ReactToRoleReveal.02",
      "intent": "ReactToRoleReveal",
      "text": "The reveal stays with us. So does the vote.",
      "weight": 1,
      "requiredTrait": "Grim",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.grim.execution.ReactToRoleReveal.03",
      "intent": "ReactToRoleReveal",
      "text": "We know what they were now. That won't give them another morning.",
      "weight": 1,
      "requiredTrait": "Grim",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    }
  ]
}
