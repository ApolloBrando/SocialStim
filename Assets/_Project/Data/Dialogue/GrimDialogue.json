{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "npc.grim.Accuse.001",
      "intent": "Accuse",
      "text": "{target}. That's where my suspicion rests.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.002",
      "intent": "Accuse",
      "text": "I don't trust {target}. Trust is getting expensive.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.003",
      "intent": "Accuse",
      "text": "I suspect {target}. An unpleasant place to start.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.004",
      "intent": "Accuse",
      "text": "The person I suspect is {target}. There's no better way to say it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.005",
      "intent": "Accuse",
      "text": "Keep questioning {target}. I don't trust them yet.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.006",
      "intent": "Accuse",
      "text": "{target} needs scrutiny. Nobody enjoys it. Do it anyway.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.007",
      "intent": "Accuse",
      "text": "I think {target} may be the threat. An ordinary miserable thought.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.008",
      "intent": "Accuse",
      "text": "Question {target}. Another uncomfortable conversation won't kill us by itself.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.009",
      "intent": "Accuse",
      "text": "{target}, I haven't found a reason to trust you.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.010",
      "intent": "Accuse",
      "text": "I'd start by questioning {target}. That's where my suspicion is.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.011",
      "intent": "Accuse",
      "text": "I don't think we should trust {target} yet. Comfort won't make them safe.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Accuse.012",
      "intent": "Accuse",
      "text": "I'm accusing {target}. There isn't a pleasant version of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.001",
      "intent": "Defend",
      "text": "I deny it. You've made an accusation, not proved a case.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.002",
      "intent": "Defend",
      "text": "I dispute the blame. Hear me before you decide.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.003",
      "intent": "Defend",
      "text": "I'm defending myself. You haven't shown I'm guilty.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.004",
      "intent": "Defend",
      "text": "I reject the accusation. A suspicion isn't a conclusion.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.005",
      "intent": "Defend",
      "text": "I won't confess to something I deny just to shorten the discussion.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.006",
      "intent": "Defend",
      "text": "Don't condemn me yet. You still need to hear my defense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.007",
      "intent": "Defend",
      "text": "I deny the accusation. Raising your voice won't prove it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.008",
      "intent": "Defend",
      "text": "I won't accept that verdict against me. The case is unproven.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.009",
      "intent": "Defend",
      "text": "I dispute the charge. Give me a hearing, however unpleasant.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.010",
      "intent": "Defend",
      "text": "I deny the blame. That's my answer, stripped down.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.011",
      "intent": "Defend",
      "text": "I'm not agreeing with the accusation. I just expected to be suspected.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Defend.012",
      "intent": "Defend",
      "text": "I reject the case against me. Whether anyone listens is another matter.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "I'm the {role}. There it is.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "My role is {role}. No better day to say it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "Put down {role} beside my name.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "I suppose you need the role. {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "I'm claiming {role}. Another thing to worry about.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "The role I have to declare is {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "{role}. That's what I'm telling the room.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "You can question this too. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "No grand reveal. Just my claim: {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "Call me the {role}. Names won't make tonight shorter.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.001",
      "intent": "Agree",
      "text": "{target} has my agreement. For what that's worth.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.002",
      "intent": "Agree",
      "text": "I support {target}'s point. Something had to make sense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.003",
      "intent": "Agree",
      "text": "I agree with {target}'s point. We can stop circling it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.004",
      "intent": "Agree",
      "text": "I'm with {target} on this. No speech required.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.005",
      "intent": "Agree",
      "text": "What {target} said will do. I agree.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.006",
      "intent": "Agree",
      "text": "What {target} said makes sense to me. I agree.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.007",
      "intent": "Agree",
      "text": "I'll back that conclusion, {target}. Don't expect applause.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.008",
      "intent": "Agree",
      "text": "I reach the same conclusion as {target}. An unpleasant agreement.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.009",
      "intent": "Agree",
      "text": "I support {target}'s point. Useful ones have been scarce.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Agree.010",
      "intent": "Agree",
      "text": "I agree with {target}. That's the whole contribution.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.001",
      "intent": "Disagree",
      "text": "I disagree with {target}'s point. It doesn't convince me.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.002",
      "intent": "Disagree",
      "text": "I don't accept {target}'s conclusion. We can endure the disagreement.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.003",
      "intent": "Disagree",
      "text": "{target} hasn't convinced me. Certainty isn't contagious today.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.004",
      "intent": "Disagree",
      "text": "I don't accept {target}'s conclusion. Neither answer is comfortable.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.005",
      "intent": "Disagree",
      "text": "Don't count me as agreeing with {target}'s point.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.006",
      "intent": "Disagree",
      "text": "I oppose that point, {target}. Quietly, if possible.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.007",
      "intent": "Disagree",
      "text": "I reject {target}'s argument. Calling it reassuring won't strengthen it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.008",
      "intent": "Disagree",
      "text": "I disagree with {target}'s point. Best say it now.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.009",
      "intent": "Disagree",
      "text": "I won't back {target}'s argument just to finish talking.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Disagree.010",
      "intent": "Disagree",
      "text": "That view from {target} doesn't survive a second look for me.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "Another chair we won't need.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "They won't be speaking again. The room has noticed.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "Death makes a tidy report out of a complicated person.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "We have less company and the same questions.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "Someone is gone. The meeting continues. That's the cruelty of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "An empty place. We can stop expecting an answer from it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "There should have been another ordinary morning for them.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "We all heard the report. Hearing it didn't make it easier.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "The dead have run out of mistakes. We haven't.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "A life ended. Nothing useful to add to that arithmetic.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "I chose. Doubt came with the ballot.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "My vote was a judgement, not a promise.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "I used what I had. It wasn't much comfort.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "The ballot was mine. So is the burden of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "I didn't find certainty. The vote couldn't wait for it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "There was no painless choice. I made one anyway.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "I meant my ballot. Regret doesn't rewrite it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "My decision came from my own assessment. No escape in that.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "I voted with the information I had, not the information I wanted.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "The choice is on record. I'll answer for it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.001",
      "intent": "Vouch",
      "text": "Don't condemn {target} yet. I want to hear them through.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.002",
      "intent": "Vouch",
      "text": "I'm backing {target} for now. That's where I stand.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.003",
      "intent": "Vouch",
      "text": "Don't condemn {target} yet. I support their right to a defense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.004",
      "intent": "Vouch",
      "text": "I oppose the accusation against {target}. We can be careful, at least.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.005",
      "intent": "Vouch",
      "text": "I trust {target} enough to speak in their defense.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Vouch.006",
      "intent": "Vouch",
      "text": "I'm supporting {target}. Hear them before deciding who to lose.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "{target} appeared {result}. That's the readout.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "I checked {target}. It came back {result}. Another fact to carry.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "The result for {target} was {result}. Record it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "My investigation returned {result} on {target}. No ceremony needed.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "Here's the finding: {target}, {result}. Make of it what you can.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "Bring {target} to trial. We may as well ask properly.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "I want a hearing for {target}. Another hard conversation.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "Put {target} on trial. The room won't enjoy it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "{target} should give a formal defense. That's my request.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "Open the hearing for {target}. Delaying the question won't soften it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.001",
      "intent": "Deflect",
      "text": "I deny it. Question {target} instead; I suspect them.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.002",
      "intent": "Deflect",
      "text": "I reject the blame. My accusation is against {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.003",
      "intent": "Deflect",
      "text": "Don't call me guilty. I want {target} examined.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.004",
      "intent": "Deflect",
      "text": "I dispute the case against me. Start looking at {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.Deflect.005",
      "intent": "Deflect",
      "text": "I deny your accusation. Now hear mine: I suspect {target}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.001",
      "intent": "StaySilent",
      "text": "I'll leave the room its silence.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.002",
      "intent": "StaySilent",
      "text": "Nothing from me. There will be other bad moments to speak.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.003",
      "intent": "StaySilent",
      "text": "I'm listening. That will have to count.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.004",
      "intent": "StaySilent",
      "text": "No addition. We can let a thought end.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.StaySilent.005",
      "intent": "StaySilent",
      "text": "I'll keep this turn empty.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "I don't expect the night to be kind.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "The danger is still here. So are we, for now.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "I'm afraid. It's become a fairly ordinary condition.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "I can face the dark without trusting it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "We have a future to fear. That's better than no future, I suppose.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "The role is known now. Too late for an easy conversation.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "A reveal. Another reason to distrust our earlier certainty.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "We know more about them now. They don't get to hear what we make of it.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "Put the revealed role beside the old claims. See what remains standing.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "That changes the record. The past stays just as unpleasant.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.001",
      "intent": "LastWords",
      "text": "You'll have one less voice to argue with.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.002",
      "intent": "LastWords",
      "text": "Remember the words if you forget the person.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.003",
      "intent": "LastWords",
      "text": "This is where my part stops. Yours won't.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.004",
      "intent": "LastWords",
      "text": "Make the next choice carefully. You can't return this one.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.LastWords.005",
      "intent": "LastWords",
      "text": "No grand ending. Just the end I got.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.001",
      "intent": "ReportAction",
      "text": "Here's the account. Nothing to brighten it. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.002",
      "intent": "ReportAction",
      "text": "The night left this to report. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.003",
      "intent": "ReportAction",
      "text": "I'll read what happened and leave it there. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.004",
      "intent": "ReportAction",
      "text": "Another record for the living. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.ReportAction.005",
      "intent": "ReportAction",
      "text": "Details, since we still need them. {result}",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Someone stole my job. I am the {role}. Figures.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.02",
      "intent": "CounterClaim",
      "text": "That claim is false. I am the {role}. Now we have another problem.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.03",
      "intent": "CounterClaim",
      "text": "I hoped to keep this quiet. I am the {role}. So much for hope.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.04",
      "intent": "CounterClaim",
      "text": "Two people claiming one role. Same old misery. I am the {role}.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.05",
      "intent": "CounterClaim",
      "text": "There goes my cover. The real {role} is me.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.06",
      "intent": "CounterClaim",
      "text": "I am the {role}. Apparently even my work has an impostor.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.07",
      "intent": "CounterClaim",
      "text": "I challenge that claim. I'm the {role}. Another problem to deal with.",
      "weight": 1,
      "requiredTrait": "Grim"
    },
    {
      "id": "npc.grim.counterclaim.08",
      "intent": "CounterClaim",
      "text": "No. You took the wrong title. I am the {role}. This will end badly.",
      "weight": 1,
      "requiredTrait": "Grim"
    }
  ]
}
