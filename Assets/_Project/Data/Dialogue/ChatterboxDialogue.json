{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "npc.chatterbox.Accuse.001",
      "intent": "Accuse",
      "text": "Can we come back to {target}? I've got a bad feeling I can't quite leave alone.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.002",
      "intent": "Accuse",
      "text": "I know I keep going round this, but {target} is still my suspect.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.003",
      "intent": "Accuse",
      "text": "{target}, can you talk me through your side? I'm having a hard time trusting you.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.004",
      "intent": "Accuse",
      "text": "Let's hear {target} before I talk myself into another theory.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.005",
      "intent": "Accuse",
      "text": "Here's where I land after all that: I suspect {target}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.006",
      "intent": "Accuse",
      "text": "I'm trying to keep an open mind, {target}, but I'm still worried about you.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.007",
      "intent": "Accuse",
      "text": "I don't want this buried in the conversation. My accusation is against {target}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.008",
      "intent": "Accuse",
      "text": "I've got plenty of questions for {target}. Let's start with the uncomfortable one.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.009",
      "intent": "Accuse",
      "text": "{target}, you probably want me to get to the point. I don't trust you yet.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.010",
      "intent": "Accuse",
      "text": "I could keep circling it, so I'll just say the name. {target}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.011",
      "intent": "Accuse",
      "text": "Can we give {target} the floor? I'd rather hear an answer than keep guessing.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Accuse.012",
      "intent": "Accuse",
      "text": "I'm putting {target} forward, and then I really am going to let them answer.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.001",
      "intent": "Defend",
      "text": "Wait, let me answer that before the next question arrives.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.002",
      "intent": "Defend",
      "text": "No, you've got me wrong. Let me start with the part you're actually asking about.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.003",
      "intent": "Defend",
      "text": "I'm trying to explain myself, and I know I'm making it longer. Please bear with me.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.004",
      "intent": "Defend",
      "text": "That's an accusation, not an answer. Can I give you mine?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.005",
      "intent": "Defend",
      "text": "I didn't do it. I'll explain, but I need you to let me finish.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.006",
      "intent": "Defend",
      "text": "You don't have to like how much I talk. Just hear what I'm saying.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.007",
      "intent": "Defend",
      "text": "I know, I know. One question at a time, and I'll try to stick to it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.008",
      "intent": "Defend",
      "text": "You're deciding what my answer means before I've got it out.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.009",
      "intent": "Defend",
      "text": "I'm not talking my way round it. I'm trying to tell you you've got the wrong person.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.010",
      "intent": "Defend",
      "text": "Could we go back to the question? I want to answer it properly.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.011",
      "intent": "Defend",
      "text": "My answer's still no. The explanation just takes a bit longer.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Defend.012",
      "intent": "Defend",
      "text": "Please don't make the vote before you've heard my side of this.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "Right, the part I should have started with: I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "I've been trying to find an opening. Apparently I have to make one. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "Before I forget what I was leading up to, my role is {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "You're going to want this on the record. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "I had a whole speech planned, but you need the answer first: {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "Actually, this is a good time to tell you I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "I should explain my timing, but let's get the claim out first. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "My role is {role}. There, now we can talk about what that means.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "Everyone still with me? Good. I'm claiming {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "This might change the conversation, which is why I'm saying it now. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.001",
      "intent": "Agree",
      "text": "Yes, {target}, that's the bit I was trying to get at.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.002",
      "intent": "Agree",
      "text": "I'd been turning it over, but {target} just put it better than I could.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.003",
      "intent": "Agree",
      "text": "Can we stay on {target}'s point? I think there's something there.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.004",
      "intent": "Agree",
      "text": "I'm with {target} on that part. Let me be specific before I wander.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.005",
      "intent": "Agree",
      "text": "That makes sense, {target}. It's where my thinking was heading too.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.006",
      "intent": "Agree",
      "text": "I was about to start a whole explanation, but {target} has saved us the trouble.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.007",
      "intent": "Agree",
      "text": "That's a yes from me, {target}. I can explain the yes if anyone needs it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.008",
      "intent": "Agree",
      "text": "I want to back {target} before we lose the thread again.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.009",
      "intent": "Agree",
      "text": "Keep going, {target}. I'm interested, and so far I agree.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Agree.010",
      "intent": "Agree",
      "text": "I'm glad you brought that up, {target}. I think you're right.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.001",
      "intent": "Disagree",
      "text": "Can I stop you there, {target}? That's where I lose the argument.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.002",
      "intent": "Disagree",
      "text": "I understand the point, {target}. I just don't end up agreeing with it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.003",
      "intent": "Disagree",
      "text": "Hang on, {target}. Hearing you out wasn't meant to sound like a yes.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.004",
      "intent": "Disagree",
      "text": "I've got a problem with that conclusion, {target}, and I should say it now.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.005",
      "intent": "Disagree",
      "text": "That's one way to read it, {target}. It isn't the way I read it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.006",
      "intent": "Disagree",
      "text": "Could we go over that last part again, {target}? I'm still unconvinced.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.007",
      "intent": "Disagree",
      "text": "{target}, I was following you until that turn. Now I'm on the other side.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.008",
      "intent": "Disagree",
      "text": "I'm not trying to talk over you, {target}. I do need to disagree.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.009",
      "intent": "Disagree",
      "text": "I know I've nodded along while listening, {target}, but I'm not persuaded.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Disagree.010",
      "intent": "Disagree",
      "text": "Before we all move on, can we hear why I don't agree with {target}?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "I had something I was saving to tell them. It seems so small now.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "I keep starting a sentence and remembering they won't answer.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "Could we say something about them before this becomes another argument?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "I normally know how to fill a silence. I don't know what belongs in this one.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "They're going to miss the end of every conversation we have from here.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "I was about to ask what they thought. My mouth got ahead of me again.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "I don't want the only thing we remember to be the death report.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "We should talk about what happened, but can we take a breath first?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "I keep hoping someone has misunderstood the report. I know that doesn't help.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "I don't know how we make room for this and still keep going.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "I kept thinking of one more possibility, and then we had to choose.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "I can talk you through the vote, if you'll give me a moment.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "I wasn't sure when I voted. I didn't become sure just because it was over.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "I put the name down myself. I don't want that lost in the rest of my explanation.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "I had reasons for the choice, and doubts about it. Both are still with me.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "Let's talk about the ballot I actually cast, before we get onto every ballot I considered.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "I didn't just go with the room. I made that call, for better or worse.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "I thought I had the explanation ready. It's harder to give it after the vote.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "You can ask me about my choice. Please let me finish answering each question.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "That's how I saw it when we voted. I'm trying to be honest about that.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Vouch.001",
      "intent": "Vouch",
      "text": "Can we let {target} talk? I've said enough for both of us already.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Vouch.002",
      "intent": "Vouch",
      "text": "I'm backing {target}, but I'd rather you heard their answer than another speech from me.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Vouch.003",
      "intent": "Vouch",
      "text": "Don't rush past {target}'s defense. I want to give it a fair hearing.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Vouch.004",
      "intent": "Vouch",
      "text": "I still trust {target} for now. We can keep asking questions without condemning them.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Vouch.005",
      "intent": "Vouch",
      "text": "Let me be clear about whose side I'm on here: {target}'s.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Vouch.006",
      "intent": "Vouch",
      "text": "I want {target} heard before this turns into a decision nobody can take back.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "I've got the result for {target}. It was {result}, before I bury it in the explanation.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "Let me give you the readout first: {target} appeared {result}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "This is the part to remember. I checked {target} and got {result}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "You were waiting for my finding on {target}. The answer came back {result}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "I'll keep the result separate from what I think it means: {target}, {result}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "I'd like a trial for {target}, with enough room to hear the actual defense.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "Can we give {target} a proper hearing instead of talking over the question?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "I'm asking to put {target} on trial. That's the request; I'll stop there.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "Let's take the case to {target} formally, and then let them answer it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "I want {target} questioned at a hearing before we drift into another subject.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Deflect.001",
      "intent": "Deflect",
      "text": "I didn't do it. And while we're asking difficult questions, I have some for {target}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Deflect.002",
      "intent": "Deflect",
      "text": "You're treating me as the answer already. Can we look at {target} before settling that?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Deflect.003",
      "intent": "Deflect",
      "text": "I'm defending myself, yes, but I'm also accusing {target}. Please hear both parts.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Deflect.004",
      "intent": "Deflect",
      "text": "I reject the blame. {target} is the person I think we should question next.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.Deflect.005",
      "intent": "Deflect",
      "text": "Let me finish. My answer is no, and my suspicion is still on {target}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.StaySilent.001",
      "intent": "StaySilent",
      "text": "I was going to add something. Actually, let's hear someone else first.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.StaySilent.002",
      "intent": "StaySilent",
      "text": "I'll stop there before I start a whole new conversation.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.StaySilent.003",
      "intent": "StaySilent",
      "text": "There's more in my head, but it can wait its turn.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.StaySilent.004",
      "intent": "StaySilent",
      "text": "I'm listening. You can hold me to that for the next minute.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.StaySilent.005",
      "intent": "StaySilent",
      "text": "Go on. I'll try not to finish your sentence for you.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "I keep talking because the silence leaves too much room for tonight.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "Does anyone know how to stop thinking about every possible thing that could go wrong?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "I was going to change the subject, but I don't think any subject feels safe now.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "I don't want to be the last person in this room when we leave.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "Can someone stay and talk a little longer? It doesn't have to be about any of this.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "Well, that changes how I heard the claim. Can we go back to it?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "I need to rethink a few things now, including some things I said quite loudly.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "Before we argue about who guessed right, let's work out what the reveal actually changes.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "There's the role, and there's what they told us. We need to put those together.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "Can we revisit the earlier discussion without all trying to explain it at once? Me included.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.LastWords.001",
      "intent": "LastWords",
      "text": "I kept thinking I'd get another chance to explain myself.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.LastWords.002",
      "intent": "LastWords",
      "text": "Please remember something I said besides how long it took to say it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.LastWords.003",
      "intent": "LastWords",
      "text": "I'd usually try to keep you talking. This time I just hope you keep listening.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.LastWords.004",
      "intent": "LastWords",
      "text": "There's so much left in my head, and now none of it will fit.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.LastWords.005",
      "intent": "LastWords",
      "text": "Let the next person finish. I know I wasn't always good at that.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportAction.001",
      "intent": "ReportAction",
      "text": "Let me get the night report out before the discussion runs away. {result}",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportAction.002",
      "intent": "ReportAction",
      "text": "I'll give you the account first, then we can talk it through. {result}",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportAction.003",
      "intent": "ReportAction",
      "text": "I've got the details here, so I won't have to rely on my memory. {result}",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportAction.004",
      "intent": "ReportAction",
      "text": "This is about last night. I'll try to keep it in order. {result}",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.ReportAction.005",
      "intent": "ReportAction",
      "text": "There's something I need everyone to hear from my report. {result}",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Hang on. I'm the {role}. That rather changes the conversation, doesn't it?",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.02",
      "intent": "CounterClaim",
      "text": "You said {role}? I was waiting to tell everyone that's my role.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.03",
      "intent": "CounterClaim",
      "text": "I need to interrupt this one. The actual {role} is me.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.04",
      "intent": "CounterClaim",
      "text": "I had a quieter way of announcing I'm the {role}, but apparently we're doing this instead.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.05",
      "intent": "CounterClaim",
      "text": "Before that claim goes any further, you should hear mine: I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.06",
      "intent": "CounterClaim",
      "text": "Well, now we both have something to explain. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.07",
      "intent": "CounterClaim",
      "text": "I'm the {role}, so I can't just nod along while you claim it.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.counterclaim.08",
      "intent": "CounterClaim",
      "text": "Can everyone hear me? That role belongs to me. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Chatterbox"
    },
    {
      "id": "npc.chatterbox.execution.ReactToDeath.01",
      "intent": "ReactToDeath",
      "text": "I thought I'd know what to say after the vote. I really don't.",
      "weight": 1,
      "requiredTrait": "Chatterbox",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.chatterbox.execution.ReactToDeath.02",
      "intent": "ReactToDeath",
      "text": "We spent all that time talking, and now they won't get another word.",
      "weight": 1,
      "requiredTrait": "Chatterbox",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.chatterbox.execution.ReactToDeath.03",
      "intent": "ReactToDeath",
      "text": "Before everyone leaves, could we just sit with what we decided?",
      "weight": 1,
      "requiredTrait": "Chatterbox",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.chatterbox.execution.ReactToRoleReveal.01",
      "intent": "ReactToRoleReveal",
      "text": "I want to go over what that role means, but I don't want to talk past what just happened.",
      "weight": 1,
      "requiredTrait": "Chatterbox",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.chatterbox.execution.ReactToRoleReveal.02",
      "intent": "ReactToRoleReveal",
      "text": "The role is there for us to see now. We should compare it with what they told us.",
      "weight": 1,
      "requiredTrait": "Chatterbox",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.chatterbox.execution.ReactToRoleReveal.03",
      "intent": "ReactToRoleReveal",
      "text": "Could we remember the revealed role tomorrow, before the next argument carries us away?",
      "weight": 1,
      "requiredTrait": "Chatterbox",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    }
  ]
}
