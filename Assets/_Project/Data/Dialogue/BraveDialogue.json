{
  "schemaVersion": 2,
  "lines": [
    {
      "id": "starter.social.accuse.aggressive",
      "intent": "Accuse",
      "text": "Let's hear your answer, {target}. I don't trust you.",
      "weight": 3,
      "conditions": [
        {
          "kind": "speakerTrait",
          "value": "Brave"
        },
        {
          "kind": "phase",
          "value": "Discussion"
        },
        {
          "kind": "targetAccused"
        }
      ],
      "metadata": {
        "emotionKey": "tense"
      },
      "requiredTrait": "Brave"
    },
    {
      "id": "starter.social.vouch.claim",
      "intent": "Vouch",
      "text": "Let {target} answer. I'll make sure they get the chance.",
      "weight": 3,
      "conditions": [
        {
          "kind": "speakerTrait",
          "value": "Brave"
        },
        {
          "kind": "targetHasClaim"
        }
      ],
      "metadata": {
        "emotionKey": "tense"
      },
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.001",
      "intent": "Accuse",
      "text": "I'm putting {target}'s name forward. Question me about it if you need to.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.002",
      "intent": "Accuse",
      "text": "{target}, I think you're a threat. I'm giving you a chance to answer.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.003",
      "intent": "Accuse",
      "text": "I'll take the heat for this one. I suspect {target}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.004",
      "intent": "Accuse",
      "text": "Put {target} under scrutiny. I'll take responsibility for raising it.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.005",
      "intent": "Accuse",
      "text": "I don't trust {target} yet. I won't pretend otherwise.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.006",
      "intent": "Accuse",
      "text": "I'm challenging {target}. Anyone can question my judgement afterward.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.007",
      "intent": "Accuse",
      "text": "We need a suspect to examine. My choice is {target}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.008",
      "intent": "Accuse",
      "text": "Stand and answer me, {target}. I don't trust you yet.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.009",
      "intent": "Accuse",
      "text": "I suspect {target}, and I'm prepared to defend that judgement.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.010",
      "intent": "Accuse",
      "text": "Don't soften my position. I am accusing {target}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.011",
      "intent": "Accuse",
      "text": "{target}, meet the question head-on. I think you're a threat.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Accuse.012",
      "intent": "Accuse",
      "text": "I'll say it plainly: I want {target} treated as a suspect.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.001",
      "intent": "Defend",
      "text": "Then ask me directly. I'm not running from your questions.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.002",
      "intent": "Defend",
      "text": "No. You've got the wrong person, and I'll tell you why.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.003",
      "intent": "Defend",
      "text": "Let me finish before you decide I'm guilty.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.004",
      "intent": "Defend",
      "text": "You can question me all day. You still have to hear the answer.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.005",
      "intent": "Defend",
      "text": "I deny it. Tell me exactly what you think I've done.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.006",
      "intent": "Defend",
      "text": "I can stand scrutiny. That doesn't make your accusation correct.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.007",
      "intent": "Defend",
      "text": "Don't vote against me on an unproven accusation. Hear me out.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.008",
      "intent": "Defend",
      "text": "I won't accept blame just because you press harder.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.009",
      "intent": "Defend",
      "text": "I'm defending myself. Judge the accusation on evidence, not volume.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.010",
      "intent": "Defend",
      "text": "I reject your conclusion about me. I'll face your questions directly.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.011",
      "intent": "Defend",
      "text": "I deny the accusation, and I expect a fair hearing.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Defend.012",
      "intent": "Defend",
      "text": "I'm not your convenient suspect. You still need to prove the case against me.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.001",
      "intent": "ClaimRole",
      "text": "I'm your {role}. Let's deal with that openly.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.002",
      "intent": "ClaimRole",
      "text": "I'll say it first: my role is {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.003",
      "intent": "ClaimRole",
      "text": "You need to know what I can do. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.004",
      "intent": "ClaimRole",
      "text": "No point hiding this now. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.005",
      "intent": "ClaimRole",
      "text": "I'm claiming {role}. I'll answer questions about that claim.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.006",
      "intent": "ClaimRole",
      "text": "I stand by this declaration. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.007",
      "intent": "ClaimRole",
      "text": "You need my role, so here it is: {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.008",
      "intent": "ClaimRole",
      "text": "I won't bury the important part. I'm your {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.009",
      "intent": "ClaimRole",
      "text": "Take the claim seriously and question it properly. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ClaimRole.010",
      "intent": "ClaimRole",
      "text": "I'm making my position public: {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.001",
      "intent": "Agree",
      "text": "I'm with {target}. Let's see that point through.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.002",
      "intent": "Agree",
      "text": "Yes, {target}. That's worth standing behind.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.003",
      "intent": "Agree",
      "text": "You don't have to argue that alone, {target}. I agree.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.004",
      "intent": "Agree",
      "text": "Keep going, {target}. You have my support on this.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.005",
      "intent": "Agree",
      "text": "That's a position worth defending, {target}. I'm with you.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.006",
      "intent": "Agree",
      "text": "I heard enough to agree with {target} here.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.007",
      "intent": "Agree",
      "text": "Let {target} finish. I support what they're saying.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.008",
      "intent": "Agree",
      "text": "I'll stand behind {target}'s conclusion on this.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.009",
      "intent": "Agree",
      "text": "I agree with {target}'s view on this question.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Agree.010",
      "intent": "Agree",
      "text": "I'm taking the same side as {target} on that question.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.001",
      "intent": "Disagree",
      "text": "Hold on, {target}. I'm not taking that leap with you.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.002",
      "intent": "Disagree",
      "text": "We can disagree without backing away, {target}. I don't accept that.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.003",
      "intent": "Disagree",
      "text": "Say it as firmly as you like, {target}. I still need convincing.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.004",
      "intent": "Disagree",
      "text": "I'm asking you to reconsider, {target}. I think that's the wrong call.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.005",
      "intent": "Disagree",
      "text": "Hold there, {target}. I reach a different answer.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.006",
      "intent": "Disagree",
      "text": "I'll say the disagreement plainly: {target} hasn't convinced me.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.007",
      "intent": "Disagree",
      "text": "{target}, your view needs more support before I'll accept it.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.008",
      "intent": "Disagree",
      "text": "I disagree with {target}, and I'm ready to explain why.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.009",
      "intent": "Disagree",
      "text": "Don't count me in with {target}'s argument.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Disagree.010",
      "intent": "Disagree",
      "text": "We can face a disagreement, {target}. Mine starts with that conclusion.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.001",
      "intent": "ReactToDeath",
      "text": "Don't shut anyone out now. We need every voice we have left.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.002",
      "intent": "ReactToDeath",
      "text": "I wish they were here to argue with us.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.003",
      "intent": "ReactToDeath",
      "text": "We can be scared and still look after each other.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.004",
      "intent": "ReactToDeath",
      "text": "Take a breath. We'll face the next part together.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.005",
      "intent": "ReactToDeath",
      "text": "We can't answer a death by refusing to face the next decision.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.006",
      "intent": "ReactToDeath",
      "text": "Remember the person we lost. Keep the discussion moving toward an answer.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.007",
      "intent": "ReactToDeath",
      "text": "I will stay in this room and help confront what happened.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.008",
      "intent": "ReactToDeath",
      "text": "The death matters. So does what we do with the time left.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.009",
      "intent": "ReactToDeath",
      "text": "We have fewer people now. Nobody gets left unheard because of that.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToDeath.010",
      "intent": "ReactToDeath",
      "text": "Take a breath. Acknowledge the loss. Then face the work in front of us.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.001",
      "intent": "VoteJustification",
      "text": "I put the name down myself. I'll answer for that.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.002",
      "intent": "VoteJustification",
      "text": "I knew I might be wrong. I wasn't going to hide from the choice.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.003",
      "intent": "VoteJustification",
      "text": "If you have questions about my vote, ask me.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.004",
      "intent": "VoteJustification",
      "text": "That was the decision I could stand behind at the time.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.005",
      "intent": "VoteJustification",
      "text": "I didn't need certainty to take responsibility for voting.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.006",
      "intent": "VoteJustification",
      "text": "The decision was difficult. Avoiding it would not have helped.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.007",
      "intent": "VoteJustification",
      "text": "I made a choice I was prepared to defend.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.008",
      "intent": "VoteJustification",
      "text": "My ballot wasn't borrowed from someone louder.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.009",
      "intent": "VoteJustification",
      "text": "I weighed the risk and cast the vote myself.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.VoteJustification.010",
      "intent": "VoteJustification",
      "text": "I'll own the outcome of my judgement rather than hide behind the tally.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Vouch.001",
      "intent": "Vouch",
      "text": "I'm standing with {target} on this one.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Vouch.002",
      "intent": "Vouch",
      "text": "You want to condemn {target}? Hear them out first.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Vouch.003",
      "intent": "Vouch",
      "text": "I'll back {target}, and you can hold me to it.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Vouch.004",
      "intent": "Vouch",
      "text": "I don't support blaming {target}. I'll stand behind that position.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Vouch.005",
      "intent": "Vouch",
      "text": "I'm on {target}'s side of this. Let them defend themselves.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Vouch.006",
      "intent": "Vouch",
      "text": "Don't rush to condemn {target}. I'm speaking in their defense.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportInvestigation.001",
      "intent": "ReportInvestigation",
      "text": "Listen up. I checked {target}, and the result was {result}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportInvestigation.002",
      "intent": "ReportInvestigation",
      "text": "Here's what I can report: {target} appeared {result}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportInvestigation.003",
      "intent": "ReportInvestigation",
      "text": "My finding on {target} was {result}. Make sure everyone hears it.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportInvestigation.004",
      "intent": "ReportInvestigation",
      "text": "I'll give the readout directly. {target}: {result}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportInvestigation.005",
      "intent": "ReportInvestigation",
      "text": "No hesitation on the report itself. I checked {target} and received {result}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.CallForTrial.001",
      "intent": "CallForTrial",
      "text": "Give {target} the floor. I want a proper hearing.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.CallForTrial.002",
      "intent": "CallForTrial",
      "text": "I want {target} on trial, with a chance to answer every question.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.CallForTrial.003",
      "intent": "CallForTrial",
      "text": "Let's put the case to {target} directly, at a hearing.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.CallForTrial.004",
      "intent": "CallForTrial",
      "text": "Open a hearing for {target}. Let's face this properly.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.CallForTrial.005",
      "intent": "CallForTrial",
      "text": "I want {target} on trial, and I'll own that request.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Deflect.001",
      "intent": "Deflect",
      "text": "I'm not accepting that blame. {target}, you need to answer too.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Deflect.002",
      "intent": "Deflect",
      "text": "You can keep questioning me, but don't leave {target} out of this.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Deflect.003",
      "intent": "Deflect",
      "text": "I deny it. My accusation is against {target}, and I'll stand by it.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Deflect.004",
      "intent": "Deflect",
      "text": "Don't treat me as guilty. I want {target} to answer my accusation.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.Deflect.005",
      "intent": "Deflect",
      "text": "I dispute the case against me. My challenge is to {target}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.StaySilent.001",
      "intent": "StaySilent",
      "text": "I've said my piece. Who's next?",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.StaySilent.002",
      "intent": "StaySilent",
      "text": "I'll hear the room before I say more.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.StaySilent.003",
      "intent": "StaySilent",
      "text": "Go on. I'm listening, even if I disagree.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.StaySilent.004",
      "intent": "StaySilent",
      "text": "I'll listen now. Speak clearly.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.StaySilent.005",
      "intent": "StaySilent",
      "text": "I have no addition worth delaying you for.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ExpressFear.001",
      "intent": "ExpressFear",
      "text": "Of course I'm afraid. I'm still here with you.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ExpressFear.002",
      "intent": "ExpressFear",
      "text": "I don't know what tonight brings. I do know we're facing it together.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ExpressFear.003",
      "intent": "ExpressFear",
      "text": "I'd rather admit I'm scared than leave someone else feeling alone.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ExpressFear.004",
      "intent": "ExpressFear",
      "text": "The risk is real enough to feel. We still have decisions to make.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ExpressFear.005",
      "intent": "ExpressFear",
      "text": "I'm frightened too. I can act without pretending otherwise.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToRoleReveal.001",
      "intent": "ReactToRoleReveal",
      "text": "All right. That means we have to look at the claims again.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToRoleReveal.002",
      "intent": "ReactToRoleReveal",
      "text": "Use what we just learned, even if it proves you wrong.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToRoleReveal.003",
      "intent": "ReactToRoleReveal",
      "text": "We owe them an honest look at what happened.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToRoleReveal.004",
      "intent": "ReactToRoleReveal",
      "text": "That reveal changes the picture. Face the change directly.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReactToRoleReveal.005",
      "intent": "ReactToRoleReveal",
      "text": "Don't defend an old assumption just because the revealed role unsettles it.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.LastWords.001",
      "intent": "LastWords",
      "text": "Stay together. You don't have to trust everyone to hear them out.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.LastWords.002",
      "intent": "LastWords",
      "text": "Make the next choice carefully. That's all I ask.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.LastWords.003",
      "intent": "LastWords",
      "text": "I won't get another turn. Make yours count.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.LastWords.004",
      "intent": "LastWords",
      "text": "Don't let this be the moment you stop thinking for yourselves.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.LastWords.005",
      "intent": "LastWords",
      "text": "My voice ends here. Your responsibility doesn't.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportAction.001",
      "intent": "ReportAction",
      "text": "I'll walk you through my night. {result}",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportAction.002",
      "intent": "ReportAction",
      "text": "Here's the account I can give you. {result}",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportAction.003",
      "intent": "ReportAction",
      "text": "Ask your questions after you've heard this. {result}",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportAction.004",
      "intent": "ReportAction",
      "text": "I can answer for this account. {result}",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.ReportAction.005",
      "intent": "ReportAction",
      "text": "No evasion from me about the night. {result}",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.01",
      "intent": "CounterClaim",
      "text": "Look at me when you say that. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.02",
      "intent": "CounterClaim",
      "text": "I'm the {role}. If you're challenging that, do it openly.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.03",
      "intent": "CounterClaim",
      "text": "You don't get to take my role unopposed. I'm the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.04",
      "intent": "CounterClaim",
      "text": "Then we have a problem. The {role} is me.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.05",
      "intent": "CounterClaim",
      "text": "I was keeping quiet for a reason. I am the {role}, and that claim is false.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.06",
      "intent": "CounterClaim",
      "text": "No hiding behind my job. I am the {role}. Face me.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.07",
      "intent": "CounterClaim",
      "text": "I will stake my name on this. I am the genuine {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.counterclaim.08",
      "intent": "CounterClaim",
      "text": "Hold it. You cannot have my role. I am the {role}.",
      "weight": 1,
      "requiredTrait": "Brave"
    },
    {
      "id": "npc.brave.execution.ReactToDeath.01",
      "intent": "ReactToDeath",
      "text": "We cast the votes. We need to face what followed.",
      "weight": 1,
      "requiredTrait": "Brave",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.brave.execution.ReactToDeath.02",
      "intent": "ReactToDeath",
      "text": "Don't leave anyone alone with this tonight.",
      "weight": 1,
      "requiredTrait": "Brave",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.brave.execution.ReactToDeath.03",
      "intent": "ReactToDeath",
      "text": "We still have people to look after. Remember that before we go.",
      "weight": 1,
      "requiredTrait": "Brave",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedDeath"
        }
      ]
    },
    {
      "id": "npc.brave.execution.ReactToRoleReveal.01",
      "intent": "ReactToRoleReveal",
      "text": "Their role is public now. Keep it in mind when we hear the next claim.",
      "weight": 1,
      "requiredTrait": "Brave",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.brave.execution.ReactToRoleReveal.02",
      "intent": "ReactToRoleReveal",
      "text": "We can still learn from the decision. We owe them that much.",
      "weight": 1,
      "requiredTrait": "Brave",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    },
    {
      "id": "npc.brave.execution.ReactToRoleReveal.03",
      "intent": "ReactToRoleReveal",
      "text": "Put the revealed role beside the claims. We need a clear answer tomorrow.",
      "weight": 1,
      "requiredTrait": "Brave",
      "conditions": [
        {
          "kind": "Phase",
          "value": "Execution"
        },
        {
          "kind": "ObservedRoleReveal"
        }
      ]
    }
  ]
}
